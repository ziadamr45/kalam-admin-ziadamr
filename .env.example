# =====================================================================
# متغيرات البيئة — لوحة التحكم السيادية «كلام له لازمة»
# انسخ هذا الملف إلى .env.local محليًا، وأدخل القيم في Vercel عند النشر
# =====================================================================

# ---------- قاعدة البيانات PostgreSQL ----------
# نفس قاعدة بيانات المنصة العامة بالضبط — هذا شرط التكامل
DATABASE_URL="postgresql://user:password@host:5432/kalam?schema=public&sslmode=require"

# ---------- أمن الجلسات (JWT) ----------
# مفتاح توقيع الجلسات — ولّده بـ: openssl rand -base64 32
ADMIN_SESSION_SECRET="ضع هنا مفتاح توقيع الجلسات"

# ---------- حساب المالك (الإنشاء الأولي فقط) ----------
# تُستخدم مرة واحدة عند تشغيل: npm run admin:create
# ثم يُنصح بحذف القيم من Vercel بعد إنشاء الحساب بنجاح
ADMIN_USERNAME="ziadamr45"
ADMIN_BOOTSTRAP_PASSWORD="ضع كلمة المرور القوية هنا عند التشغيل الأول"

# ---------- جدار حماية IP (اختياري) ----------
# قائمة عناوين IP المسموح لها بالوصول مفصولة بفواصل
# اتركها فارغة لتعطيل التقييد الصارم (الوضع الموصى به عند البداية)
TRUSTED_IPS=""
# فرض القائمة الصارمة: true = حظر أي IP خارج القائمة قبل حتى صفحة الدخول
ENFORCE_IP_WHITELIST="false"
# حظر الأجهزة غير الموثوقة: true = رفض أي جهاز لم يُعتمد مسبقًا من صفحة الأمان
BLOCK_UNTRUSTED_DEVICES="false"

# ---------- مهام Vercel Cron (النشر المجدول) ----------
# حماية مسار /api/cron/publish-scheduled — ولّده بـ: openssl rand -hex 32
CRON_SECRET="ضع هنا سر المهام المجدولة"

# ---------- التكامل مع المنصة العامة ----------
# رابط المنصة العامة لإعادة التحقق الفوري عند النشر (نفس REVALIDATE_SECRET فيها)
PUBLIC_URL="https://kalam-ziadamr.vercel.app"
REVALIDATE_SECRET="نفس سر إعادة التحقق الموجود في المنصة العامة"
NEXT_PUBLIC_ADMIN_URL="https://kalam-admin-ziadamr.vercel.app"

# ---------- قناة البريد المعاملاتي (Resend) ----------
# تفعّل قناة EMAIL في المرسل المركزي للإشعارات (تنبيهات السيادة والطوارئ).
# يُدار المفتاح للريبوين معًا من: scripts/push-resend-env.js
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
SECURITY_EMAIL_FROM="كلام له لازمة <onboarding@resend.dev>"
