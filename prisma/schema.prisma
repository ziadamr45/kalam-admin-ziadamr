// =====================================================================
// «كلام له لازمة» — المخطط النهائي الموحّد لقاعدة البيانات PostgreSQL
// يستخدمه المشروعان معًا: المنصة العامة + لوحة التحكم السيادية
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================ المقالات ============================

enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Section {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  color       String? // لون هوية القسم — hex مثل #A16A1F
  icon        String? // أيقونة القسم — إيموجي أو رمز نصي
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Article {
  id                  String        @id @default(cuid())
  title               String
  slug                String        @unique
  summary             String        @db.Text
  content             String        @db.Text
  contentWithTashkeel String        @db.Text
  coverImage          String?
  audioUrl            String?
  audioDurationSec    Float?
  audioCues           Json?
  audioWords          Json?      // مصفوفة الطوابع الزمنية للكلمات [{w, s, e}] لمزامنة التظليل اللحظي
  audioVoice          String?    // صوت Gemini المستخدم في التوليد
  audioPublicId       String?    // معرف Cloudinary للحذف والاستبدال الآمن
  audioGeneratedAt    DateTime?  // وقت التوليد الآلي
  /* دورة حياة التوليد الخلفي غير المتزامن — المهمة تعيش في الخادم لا في المتصفح */
  audioStatus         String     @default("NONE") // NONE | PROCESSING | READY | FAILED
  audioProgress       Int        @default(0)      // المقاطع المكتملة
  audioTotal          Int        @default(0)      // إجمالي مقاطع المهمة الحالية
  audioChunks         Json?      // سجل المقاطع المؤقت [{text, words, url, publicId, durationSec, timings, attempts, notBefore, mime}]
  audioError          String?    // ملاحظة/خطأ آخر خطوة (تُمسح عند النجاح)
  audioJobId          String?    // معرف المهمة الحالية — يحرس سلاسل المعالجة اليتيمة ويقتل التسابق
  audioUpdatedAt      DateTime?  // نبض آخر خطوة معالجة — لكشف التعليق وعرض stale
  readingTimeSec      Int           @default(60)
  status              ArticleStatus @default(DRAFT)
  commentsEnabled     Boolean       @default(true) // باب التعليق لكل مقال — يُطوى ويُفتح لحظيًا من التيرمينال السيادي دون نشر
  authorIntent        String?       @db.Text // التغذية الفكرية السرية لمساعد النقاش — لا تُعرض للجمهور إطلاقًا، تُحقن في System Prompt حصريًا
  tashkeelEnabled     Boolean       @default(true)
  checklistPassed     Boolean       @default(false)
  checklistData       Json?
  views               Int           @default(0)
  completedReads      Int           @default(0)
  publishedAt         DateTime?
  scheduledAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  sectionId    String?
  section      Section?      @relation(fields: [sectionId], references: [id])
  comments     Comment[]
  interactions Interaction[]
  pageViews    PageView[]
  shares       SocialShare[]
  savedBy      SavedArticle[]
  impactLogs   ImpactLog[]
  aiDiscussions AiDiscussionUsage[]
  readingProgress ReadingProgress[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([sectionId])
}

// ============================ المجتمع ============================

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

/* الرتب الوظيفية للحسابات — سلّم السيادة المعتمد في المنصة
   OWNER حصري لحساب صاحب المنصة السيادي، ثم ADMIN وEDITOR وMODERATOR
   للمستخدمين المميزين من استوديو الحسابات المميزة بلوحة التحكم */
enum Role {
  USER
  MODERATOR
  EDITOR
  ADMIN
  OWNER
}

model User {
  id            String    @id @default(cuid())
  googleId      String?   @unique
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  banned        Boolean   @default(false)
  banReason     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /* ============ محرك الهوية المستقلة (Custom Profile Engine) ============ */
  customName    String? // الاسم المعروض الذي يختاره القارئ — الأصل يبقى بيانات Google للتوثيق
  customImage   String? // رابط الصورة الشخصية المرفوعة عبر Cloudinary — تُعرض بدل صورة Google عند وجودها
  bio           String? @db.Text // نبذة فكرية مقتضبة يعبر بها القارئ عن نفسه

  /* ============ محرك رصيد الأثر الفكري (Reader Impact Engine) ============ */
  impactScore     Int     @default(0) // إجمالي رصيد الأثر المكتسب
  intellectualRank String @default("قارئ متأمل") // الرتبة الفكرية المحسوبة آليًا من الرصيد
  hasCompletedOnboarding Boolean @default(false) // ختم تجربة التهيئة والجولة التفاعلية — تُعرض مرة واحدة للأعضاء الجدد

  /* ============ منظومة التوثيق الرسمي — إثبات الهوية فقط (Proof of Identity) ============ */
  role             Role      @default(USER)  // الرتبة الوظيفية — OWNER حصري لصاحب المنصة
  isVerified       Boolean   @default(false) // علامة الصح الرسمية بجانب الاسم أينما وُجد — بلا أي امتيازات بذاتها
  verifiedAt       DateTime? // لحظة منح التوثيق الرسمي
  verificationType String?   // تصنيف التوثيق: OWNER مؤسس | OFFICIAL_AUTHOR كاتب رسمي | FAMILY_CORE فرد عائلة موثق | NOTABLE نخبة أهل الكلمة
  verificationLabel String?  // مسمى عرض اختياري بجانب الختم — يفوق التسمية الافتراضية للتصنيف

  /* ============ العضوية المميزة المستقلة — الامتيازات والشارات (VIP Privileges & Badges) ============ */
  isVip           Boolean   @default(false) // عضوية التمييز المستقلة — لا علاقة لها بالتوثيق الرسمي
  vipBadgeTitle   String?   // مسمى الكبسولة الملونة: «مؤسس المنصة»، «عضو فخري»، «مساهم متميز»
  vipBadgeColor   String?   // كود لون الكبسولة السداسي: #D97706 ذهبي، #2563EB أزرق ملكي، #6B8E23 زيتي
  vipReason       String?   // سبب منح التمييز — إلزامي، يُحفظ في السجل ويُرسل للمستخدم
  vipGrantedAt    DateTime? // لحظة منح العضوية المميزة
  vipPrivileges   Json?     // كائن الصلاحيات: unlimitedAiChat، bypassRateLimits، bypassCooldowns، ahlAlKalimaAccess، selfPinComment، vipCommentBorder، betaFeatures

  /* ============ البطاقة الفكرية الموسعة — لحاملي التوثيق (Rich Profile Card) ============ */
  extendedBio     String?   @db.Text // نبذة فكرية موسعة تظهر في بطاقة الهوية عند الضغط على الاسم الموثق
  personalLinks   Json?     // روابط شخصية { portfolio، github، devto، linkedin، x } تظهر في البطاقة الغنية

  accounts     Account[]
  sessions     Session[]
  comments     Comment[]
  commentVotes CommentVote[]
  interactions Interaction[]
  savedArticles SavedArticle[]
  pushSubscriptions UserPushSubscription[]
  notifications     UserNotification[]
  impactLogs        ImpactLog[]
  proposals         UserProposal[]
  aiDiscussions     AiDiscussionUsage[]
  loginLogs         LoginLog[]
  readingProgress   ReadingProgress[]
}

/* حصة نقاش الذكاء الاصطناعي الدائمة — سجل استهلاك صارم لكل قارئ مسجل
   في كل مقال: يتحقق منه الخادم قبل أي نداء لـ Gemini ولا يُصفَّر بالتحديث */
model AiDiscussionUsage {
  id            String   @id @default(cuid())
  userId        String
  articleId     String
  messageCount  Int      @default(0)
  lastMessageAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([articleId])
}

/* مكتبة القارئ المتزامنة — محفوظات الحساب عبر كل الأجهزة */
model SavedArticle {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, createdAt(sort: Desc)])
}

enum CommentVoteType {
  LIKE
  DISLIKE
}

model Comment {
  id            String        @id @default(cuid())
  articleId     String
  article       Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  guestName     String?
  guestFp       String?
  content       String        @db.Text
  status        CommentStatus @default(PENDING)
  flagged       Boolean       @default(false)
  flagReasons   String[]
  riskScore     Float         @default(0)
  reportCount   Int           @default(0)
  editedByAdmin Boolean       @default(false)
  isInspiring   Boolean       @default(false) // تمييز «تعليق فكري ملهم» بيد الأدمن — +30 نقطة أثر وثبوت أعلى المقال
  selfPinnedAt  DateTime? // تثبيت ذاتي من كاتبه — حصري لحاملي صلاحية selfPinComment، واحد لكل كاتب في كل مقال
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  reports       CommentReport[]
  votes         CommentVote[]

  @@index([articleId, status])
  @@index([status, createdAt(sort: Desc)])
}

model CommentReport {
  id         String   @id @default(cuid())
  commentId  String
  comment    Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  reporterFp String?
  createdAt  DateTime @default(now())

  @@index([commentId])
}

/* تصويتات القارئين على التعليقات — إعجاب أو عدم إعجاب، صوت واحد لكل قارئ لكل تعليق */
model CommentVote {
  id        String          @id @default(cuid())
  commentId String
  comment   Comment         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     CommentVoteType
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, commentId])
  @@index([commentId, value])
}

model Interaction {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  visitorFp String?
  value     Int // 1 = إعجاب ، -1 = عدم إعجاب
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([articleId, visitorFp])
  @@unique([articleId, userId])
}

model SocialShare {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  platform  String
  quoteLen  Int?
  createdAt DateTime @default(now())

  @@index([articleId, platform])
}

model PageView {
  id          String   @id @default(cuid())
  articleId   String?
  article     Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  path        String
  sessionId   String
  visitorFp   String?
  referrer    String?
  device      String?
  country     String? // دولة الزائر — من ترويسات Vercel الطرفية x-vercel-ip-country
  city        String? // المدينة التقريبية — من ترويسات Vercel الطرفية
  readSeconds Int?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([articleId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

// ============ محرك رصيد الأثر الفكري (Gamification & Reader Impact Engine) ============

/* سجل الأثر — توثيق نقطة بنقطة لمنع التلاعب وتكرار الاحتساب.
   الاقتصاد المعاير (أوزان رصينة):
   READ_COMPLETE (قراءة متأنية +1 بسقف مرتين يوميًا) | AI_DISCUSS (نقاش عميق +1)
   | COMMENT_APPROVED (تعليق هادف +2) | COMMENT_LIKED (إعجاب قارئ مسجل بتعليقك +1)
   | COMMENT_INSPIRING (تمييز إداري +10) | COMMENT_UNFEATURED (إلغاء التمييز -10 عكسي موثق)
   | QUOTE_SHARE (اقتباس +1) | CHANNEL_UNLOCKED (افتتاح قناة أهل الكلمة — توثيق احتفالي)
   | CALIBRATION (معايرة) | ADMIN_ADJUST (منح/خصم إداري يدوي) */
model ImpactLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionType String
  points     Int // موجبة للمنح وسالبة للخصم الإداري
  articleId  String?
  article    Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  reason     String? // سبب التعديل الإداري اليدوي
  dedupKey   String? @unique // مفتاح منع التكرار: READ:{user}:{article} مثلًا — قيد فريد على مستوى القاعدة
  createdAt  DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([actionType, createdAt])
}

/* مقترحات «أهل الكلمة» — قناة خاصة لأصحاب أعلى رتبة فكرية ترسل مباشرة للأدمن */
model UserProposal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled, createdAt(sort: Desc)])
}

// ==================== الأمن والإدارة (لوحة التحكم) ====================

model AdminUser {
  id            String    @id @default(cuid())
  username      String    @unique
  passwordHash  String
  totpSecretEnc String? // مشفّر AES-256-GCM
  totpEnabled   Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions  AdminSession[]
  devices   TrustedDevice[]
  auditLogs AuditLog[]
}

model AdminSession {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  ip         String?
  userAgent  String?
  deviceHash String?
  trusted    Boolean   @default(false)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([adminId])
}

model TrustedDevice {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  deviceHash String
  label      String?
  lastIp     String?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@unique([adminId, deviceHash])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  username  String
  ip        String
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([username, createdAt])
  @@index([ip, createdAt])
}

model IpRule {
  id        String   @id @default(cuid())
  ip        String   @unique
  mode      String // ALLOW | DENY
  note      String?
  createdAt DateTime @default(now())
}

model SecurityAlert {
  id        String   @id @default(cuid())
  type      String
  severity  String   @default("INFO") // INFO | WARN | CRITICAL
  message   String
  meta      Json?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([resolved, createdAt(sort: Desc)])
}

model AuditLog {
  id        String     @id @default(cuid())
  adminId   String?
  admin     AdminUser? @relation(fields: [adminId], references: [id])
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime   @default(now())

  @@index([createdAt(sort: Desc)])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// ==================== المحتوى القانوني والرسائل ====================

/* الصفحات القانونية — نصوصها قابلة للتحرير من لوحة التحكم دون تعديل أكواد */
model LegalPage {
  id        String   @id @default(cuid())
  slug      String   @unique // privacy | terms | dialogue-ethics
  title     String
  content   String   @db.Text
  updatedAt DateTime @updatedAt
}

/* رسائل صفحة «اتصل بنا» — تصل مباشرة إلى لوحة التحكم */
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String?
  subject   String?
  body      String   @db.Text
  ip        String?
  userAgent String?
  read      Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt(sort: Desc)])
}

// ==================== سجلات الشفافية الرقابية ====================

/* أحداث المنصة الحية: دخول Google، تعليقات، تصويتات، حفظ.. كل حركة مرئية للأدمن */
model AuditEvent {
  id         String   @id @default(cuid())
  type       String // AUTH_LOGIN_SUCCESS | AUTH_LOGIN_BLOCKED | COMMENT_SUBMITTED | VOTE | SAVE | CONTACT | ...
  actorType  String   @default("GUEST") // USER | GUEST | SYSTEM
  actorId    String?
  actorLabel String?
  message    String?
  meta       Json?
  path       String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([type, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

/* أخطاء برمجية لحظية يرفعها المتصفح — يعلم الأدمن بأي عطَل فورًا */
model ErrorReport {
  id         String   @id @default(cuid())
  digest     String   @unique // تجميع الأخطاء المتطابقة
  message    String
  stack      String?  @db.Text
  path       String?
  userAgent  String?
  count      Int      @default(1)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([lastSeenAt(sort: Desc)])
}

// ==================== إشعارات الويب الفورية (Web Push) ====================

/* اشتراكات إشعارات الأدمن الفورية — هاتفه وحاسوبه (معيار Web Push + VAPID) */
model AdminPushSubscription {
  id          String   @id @default(cuid())
  endpoint    String   @unique // رابط قناة الإشعار من مزود المتصفح (FCM/Apple)
  p256dh      String // مفتاح التشفير العام للاشتراك
  auth        String // سر المصادقة للاشتراك
  userAgent   String?
  deviceLabel String? // وصف اختياري للجهاز (هاتف أندرويد، حاسوب العمل..)
  lastSeenAt  DateTime @default(now()) @updatedAt
  createdAt   DateTime @default(now())

  @@index([lastSeenAt(sort: Desc)])
}

/* اشتراكات إشعارات الويب للمستخدمين المسجلين بجوجل — مربوطة بحسابهم */
model UserPushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  lastSeenAt DateTime @default(now()) @updatedAt
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([lastSeenAt(sort: Desc)])
}

/* سجل تحديثات المنصة — يُوثَّق من لوحة التحكم ويُبث للمستخدمين تلقائيًا */
model PlatformUpdate {
  id          String   @id @default(cuid())
  title       String // عنوان التحديث
  details     String   @db.Text // ما تم إنجازه بالتحديد
  kind        String   @default("FEATURE") // FEATURE | MAINTENANCE | INTELLECTUAL
  createdAt   DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

/* الإشعارات الداخلية لجرس المستخدم — تُنشأ عند البث الجماهيري أو الإشعار المخصص */
model UserNotification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String    @db.Text
  url       String? // مسار المنصة الذي يفتح عند النقر
  kind      String    @default("BROADCAST") // UPDATE | BROADCAST | TARGETED
  updateId  String? // ربط اختياري بسجل PlatformUpdate
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}

// ===================== جداول Auth.js القياسية =====================

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ============ محرك أمن الحسابات (Sovereign Account Security Engine) ============

/* سجل عمليات الدخول — توثيق سيادي لكل دخول Google: الجهاز والمتصفح والموقع
   التقريبي، مع بصمة الجهاز (deviceHash) لتمييز النشاط المعتاد من غير المعتاد،
   وإشعار أمني فوري (بريد + دفع + داخل المنصة) عند الدخول من جهاز جديد */
model LoginLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email       String?
  ip          String?
  userAgent   String?  @db.Text
  deviceType  String? // mobile | desktop | tablet
  browser     String?
  os          String?
  city        String?
  region      String?
  country     String?
  deviceHash  String // sha256(UA) — مفتاح مقارنة النشاط المعتاد
  isNewDevice Boolean  @default(false) // هل هذا أول ظهور لهذه البصمة لهذا الحساب؟
  notified    Boolean  @default(false) // هل أُرسل التنبيه الأمني؟
  channels    String? // ما نُقل عبره التنبيه: email,push,inapp
  createdAt   DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([deviceHash])
}

// ============ محرك استئناف القراءة (Continue Reading Engine) ============

/* موضع القراءة المحفوظ لكل قارئ في كل مقال — يزامن العائم «توقفت عند X%»
   عبر الأجهزة، ويعمل بجانب نسخة localStorage المحلية لسرعة الاستجابة */
model ReadingProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  progress  Int      @default(0) // نسبة التقدم 0-100
  scrollY   Int      @default(0) // موضع التمرير بالبكسل
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, articleId])
  @@index([userId, updatedAt(sort: Desc)])
}

// ============ مركز السيطرة السيادي (Sovereign Control Center) ============

/* جدول التكوين السيادي — كل نص وعلم ومعيار اقتصادي في المنصة يُعدَّل
   من استوديو التكوين أو التيرمينال أو MCP ويُطبَّق لحظيًا دون إعادة نشر */
model SiteConfig {
  key       String   @id
  value     Json
  category  String   @default("GENERAL") // BRANDING | TEXTS | FLAGS | IMPACT | GOVERNANCE
  label     String? // وصف عربي مقتضب للقيمة — يظهر في استوديو التكوين
  updatedBy String? // من آخر من عدّل: admin:<username> | cli | mcp
  updatedAt DateTime @updatedAt

  @@index([category])
}

/* مرصد الحركة الحي — كل استدعاءات الخادم (Route Handlers و Server Actions
   وصفحات SSR) بـ IP والمسار ونوع الجهاز وربط معرف القارئ */
model RequestLog {
  id         String   @id @default(cuid())
  requestId  String   @unique // معرف ارتباط يربط الطلب بأخطائه (x-kalam-rid)
  app        String   @default("PUBLIC") // PUBLIC | ADMIN
  method     String
  path       String
  status     Int? // null = اكتمل بلا كود مرصود؛ يُثبَّت 500 فور خطأ مرتبط
  durationMs Int?
  ip         String?
  device     String? // mobile | desktop | tablet | bot
  userId     String?
  userEmail  String?
  userAgent  String?  @db.Text
  country    String?
  isError    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([isError, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([path])
  @@index([path, ip, createdAt(sort: Desc)]) // درع حد المعدل الدائم العابر للنسخ
}

/* أخطاء التشغيل اللحظية — Stack Trace كامل فور الوقوع (instrumentation) */
model ServerErrorLog {
  id         String   @id @default(cuid())
  digest     String // بصمة تجميع الأخطاء المتطابقة — لعدّ التكرار
  message    String
  stack      String?  @db.Text
  path       String?
  method     String?
  routeType  String? // route-handler | server-action | render | middleware
  requestId  String?
  app        String   @default("PUBLIC") // PUBLIC | ADMIN
  count      Int      @default(1)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([digest])
  @@index([lastSeenAt(sort: Desc)])
}

/* عدادات الاستهلاك اليومي للواجهات الخارجية — Gemini/Resend/Cloudinary
   تُحتسب بتوقيت القاهرة وتُعرض في شاشة الحصص الحية */
model ApiUsageCounter {
  id       String @id @default(cuid())
  provider String // GEMINI_CHAT | GEMINI_TTS | RESEND_EMAIL | CLOUDINARY_UPLOAD
  day      String // YYYY-MM-DD بتوقيت القاهرة
  count    Int    @default(0)

  @@unique([provider, day])
  @@index([day])
}

// ============ سجل التدقيق السيادي ومحو البيانات (Master Audit & GDPR Ledger) ============

/* تصنيفات السجل الرقابي الموحد — كل إجراء حساس في المنصة يندرج تحت واحد منها */
enum AuditActionCategory {
  USER_SELF_ACTION // حذف حساب ذاتي، تعديل ملف، مسح محفوظات
  ADMIN_MODERATION // حظر، رفع حظر، حذف حساب، تمييز/إلغاء تمييز تعليق
  ADMIN_VIP_CHANGE // منح توثيق، ترقية رتبة، تعديل صلاحيات
  SYSTEM_CONFIG_CHANGE // تعديل إعدادات المنصة، أوزان النقاط
}

/* سجل التدقيق السيادي غير القابل للتلاعب — يوثق أدق تفاصيل تحركات
   المشرفين والمستخدمين: الفاعل والدور والسبب إلزاميًا والدليل المصور
   والقيم السابقة والجديدة، ويغذي شاشة الرقابة وتقارير PDF الدورية
   وأدوات MCP لـ Gemini Spark. لا يُحذف منه شيء أبدًا (حق الاحتفاظ
   القانوني بسجل غير معرِّف بعد محو الحسابات). */
model AuditTrail {
  id             String               @id @default(cuid())
  actorId        String               // من قام بالفعل (أدمن، مشرف، أو المستخدم نفسه)
  actorEmail     String
  actorRole      String               // OWNER, ADMIN, MODERATOR, USER, SYSTEM
  actionCategory AuditActionCategory
  actionType     String               // مثل: USER_HARD_DELETE, ACCOUNT_BANNED, COMMENT_FEATURED
  targetId       String?              // المعرف الخاص بالعنصر المستهدف
  targetEmail    String?              // بريد المستخدم المستهدف
  reason         String?              // سبب الإجراء الإلزامي
  evidenceUrl    String?              // رابط لقطة الشاشة المرفوعة كدليل
  metadata       Json?                // تفاصيل تقنية (IP, User-Agent, القيم السابقة والجديدة)
  createdAt      DateTime             @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([actionCategory])
}
